/* =========================
   成员 / 账单页面
   ========================= */

/* 添加按钮 */
.small-button {
  min-width: 120rpx;
  height: 64rpx;

  padding: 0 20rpx;

  margin: 0;

  border: none;
  border-radius: 999rpx;

  background-color: var(--color-cream);

  color: var(--color-primary-dark);

  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

/* 去除微信 button 默认边框 */
.small-button::after {
  border: none;
}

/* 操作提示 */
.tip-text {
  margin-bottom: 8rpx;

  font-size: 22rpx;

  color: #b5afa2;
}

/* 普通成员绑定提示 */
.bind-desc {
  display: block;

  margin-top: 14rpx;

  font-size: 24rpx;
  line-height: 1.6;

  color: #8c857a;
}

/* 成员 / 账单项目 */
.member-item,
.bill-item {
  display: flex;
  align-items: center;

  padding: 24rpx 0;

  border-bottom: 1rpx solid #f0ece0;
}

/* 最后一条取消分割线 */
.member-item:last-child,
.bill-item:last-child {
  border-bottom: none;
}

/* 主信息区域 */
.member-main,
.bill-main {
  flex: 1;
  min-width: 0;
}

/* 成员名称 / 账单标题 */
.member-name,
.bill-title {
  display: block;

  font-size: 28rpx;
  font-weight: 500;

  color: var(--color-text);
}

/* 描述 / 时间 */
.member-desc,
.bill-time {
  display: block;

  margin-top: 8rpx;

  font-size: 24rpx;
  color: #8c857a;
}

.member-desc {
  word-break: break-all;
}

/* 成员剩余次数 */
.member-right {
  min-width: 90rpx;

  text-align: right;
}

.member-count {
  font-size: 32rpx;
  font-weight: 600;

  color: var(--color-primary-dark);
}

.member-unit {
  margin-left: 4rpx;

  font-size: 22rpx;
  color: #8c857a;
}

/* 账单金额 */
.bill-amount {
  margin-left: 20rpx;

  font-size: 28rpx;
  font-weight: 600;

  color: var(--color-text);
}

/* 核销：红色 */
.amount-consume {
  color: #e05a4e;
}

/* 充值：绿色 */
.amount-recharge {
  color: #3f9d63;
}

/* =========================
   成员绑定弹层
   ========================= */

.bind-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;

  display: flex;
  align-items: flex-end;

  background: rgba(43, 38, 32, 0.45);
}

.bind-panel {
  width: 100%;

  padding: 28rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));

  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
}

.bind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 24rpx;
}

.bind-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.bind-close {
  width: 56rpx;
  height: 56rpx;

  border-radius: 50%;
  background: var(--color-page-bg);
  color: #8c857a;

  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
}

/* 我的标记头像 */
.avatar-me {
  background: var(--color-cream);
  border: 2rpx solid var(--color-primary);
}

/* 权限标签（页面级补充） */
.tag {
  display: inline-flex;
  align-items: center;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-owner {
  background: var(--color-cream);
  color: var(--color-primary-dark);
}

.tag-member {
  background: #f3f4f6;
  color: #8c857a;
}

.tag-current {
  background: #e8f5ec;
  color: #3f9d63;
}

/* 邀请二维码弹层 */
.qr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(43, 38, 32, 0.55);
}

.qr-panel {
  width: 560rpx;

  padding: 32rpx;

  background: #ffffff;
  border-radius: 24rpx;
}

.qr-body {
  display: flex;
  flex-direction: column;
  align-items: center;

  padding: 24rpx 0 8rpx;
}

.qr-image {
  width: 400rpx;
  height: 400rpx;
}

.qr-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 400rpx;
  height: 400rpx;

  background: var(--color-page-bg);
  color: #b5afa2;
  font-size: 24rpx;
}

.qr-code {
  margin-top: 24rpx;

  font-size: 30rpx;
  font-weight: 600;

  color: var(--color-text);
}

.qr-tip {
  margin-top: 12rpx;

  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;

  color: #8c857a;
}
