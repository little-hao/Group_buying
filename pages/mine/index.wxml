<!--
  我的
  1. 微信登录/注册与头像昵称资料
  2. 创建/切换账本
  3. 通知中心与订阅消息状态
-->

<view class="page">

  <view class="page-header">
    <text class="page-title">我的</text>
    <text class="page-subtitle">账户与拼单账本</text>
  </view>

  <!-- 云同步状态 -->
  <view wx:if="{{!cloudReady}}" class="card cloud-warning">
    <text class="card-title">云同步未连接</text>
    <text class="bind-desc">{{cloudError || '请确认 API 服务已部署且域名已配置'}}</text>
    <button class="primary-button mt-16" bindtap="handleRetryCloud">重新连接</button>
  </view>

  <!-- 登录 -->
  <view wx:if="{{!isLogin}}" class="card">
    <view class="flex-between">
      <text class="card-title">微信登录注册</text>
      <text class="text-secondary">同一微信账号多端同步</text>
    </view>
    <text class="bind-desc">登录后可创建账本，也可通过邀请码加入他人账本。</text>
    <button class="primary-button mt-24" bindtap="handleWechatLogin">微信登录注册</button>
  </view>

  <block wx:else>

    <!-- 账户 -->
    <view class="card user-card">
      <image
        wx:if="{{userInfo.avatarUrl && !avatarDraft}}"
        class="avatar user-avatar-img"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      ></image>
      <image
        wx:elif="{{avatarDraft}}"
        class="avatar user-avatar-img"
        src="{{avatarDraft}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar user-avatar">{{avatarText}}</view>

      <view class="user-main">
        <text class="user-name">{{userInfo.name || '微信用户'}}</text>
        <text class="user-desc">
          {{roleText || '未加入账本'}}{{userInfo.platformAdmin ? ' · 后台管理员' : ''}}
        </text>
      </view>

      <text class="link-text" bindtap="toggleProfileEditor">
        {{showProfileEditor ? '收起' : '编辑资料'}}
      </text>
    </view>

    <!-- 头像昵称资料 -->
    <view wx:if="{{showProfileEditor}}" class="card profile-card">
      <text class="card-title">选择微信头像与昵称</text>

      <view class="profile-body">
        <button
          class="avatar-pick"
          open-type="chooseAvatar"
          bindchooseavatar="handleChooseAvatar"
        >
          <image
            wx:if="{{avatarDraft || userInfo.avatarUrl}}"
            class="avatar avatar-pick-img"
            src="{{avatarDraft || userInfo.avatarUrl}}"
            mode="aspectFill"
          ></image>
          <text wx:else class="avatar-pick-text">选头像</text>
        </button>

        <view class="profile-fields">
          <input
            class="form-input"
            type="nickname"
            placeholder="输入微信昵称"
            placeholder-class="form-input-placeholder"
            value="{{nicknameDraft}}"
            bindinput="handleNicknameInput"
          />
          <button class="primary-button mt-16" bindtap="handleSaveProfile">保存资料</button>
        </view>
      </view>
    </view>

    <!-- 我的账本 -->
    <view class="card">
      <view class="flex-between mb-16">
        <text class="card-title">我的账本</text>
        <button class="small-button" bindtap="handleCreateBook">+ 创建</button>
      </view>

      <view wx:if="{{myBooks.length > 0}}" class="book-list">
        <view
          wx:for="{{myBooks}}"
          wx:key="id"
          class="book-list-item {{item.active ? 'book-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="handlePickBook"
        >
          <view class="book-list-main">
            <view class="flex">
              <text class="member-name">{{item.name}}</text>
              <text class="tag {{item.role === 'member' ? 'tag-member' : 'tag-owner'}}">{{item.roleText}}</text>
              <text wx:if="{{item.active}}" class="tag tag-current">当前</text>
            </view>
            <text class="book-list-desc">
              剩余 {{item.remainingCount}} / {{item.totalCount}} 次
              <text wx:if="{{item.boundName}}"> · {{item.boundName}}</text>
            </text>
          </view>
          <text class="list-arrow">›</text>
        </view>
      </view>

      <view wx:else class="empty slim-empty">
        <text class="empty-title">{{isLogin ? '还没有账本' : '登录后开始使用'}}</text>
        <text class="empty-desc">创建账本成为创建者，或扫码/输入邀请码加入</text>
      </view>
    </view>

    <!-- 当前账本 -->
    <view wx:if="{{book && book.id}}" class="card">
      <view class="flex-between">
        <text class="card-title">{{book.name}}</text>
        <text class="role-tag {{canManage ? 'role-admin' : 'role-member'}}">{{roleText}}</text>
      </view>
      <view class="stats-card mt-16">
        <view class="stats-item">
          <text class="stats-number">{{book.totalCount}}</text>
          <text class="stats-label">总次数</text>
        </view>
        <view class="stats-item">
          <text class="stats-number">{{book.usedCount}}</text>
          <text class="stats-label">已核销</text>
        </view>
        <view class="stats-item">
          <text class="stats-number text-primary">{{book.remainingCount}}</text>
          <text class="stats-label">剩余</text>
        </view>
      </view>
      <button class="secondary-button mt-24" bindtap="goHome">进入该账本</button>
    </view>

    <!-- 通知 / 权限 -->
    <view class="card">
      <view class="flex-between">
        <view class="admin-title">
          <text class="card-title">{{canManage ? '通知' : '成员权限'}}</text>
          <text wx:if="{{canManage && unreadCount > 0}}" class="unread-badge">{{unreadCount}}</text>
        </view>
        <text class="role-tag {{canManage ? 'role-admin' : 'role-member'}}">{{canManage ? '管理' : '成员'}}</text>
      </view>

      <view wx:if="{{canManage}}">
        <view class="flex-between mt-16">
          <text class="text-secondary">未读 {{unreadCount}} 条</text>
          <view class="flex">
            <text class="link-text" bindtap="handleReadAll">全部已读</text>
            <text class="link-text danger" bindtap="handleClearNotifications">清空</text>
          </view>
        </view>

        <button wx:if="{{templateConfigured}}" class="small-button mt-16" bindtap="handleEnableNotifications">
          授权订阅消息
        </button>
        <view wx:else class="tip-text mt-16">
          订阅模板未配置，当前仅应用内通知；请在 cloud-config.js 填写模板 ID。
        </view>

        <view wx:if="{{notifications.length > 0}}" class="notice-list mt-16">
          <view wx:for="{{notifications}}" wx:key="id" class="notice-item">
            <view class="notice-main">
              <text class="notice-title">{{item.memberName}} 核销了 {{item.count}} 次</text>
              <text class="notice-time">{{item.timeText}}</text>
              <text wx:if="{{item.subscribe && item.subscribe.ok}}" class="notice-status ok">微信通知已送达</text>
              <text wx:elif="{{item.subscribe && !item.subscribe.ok}}" class="notice-status fail">
                微信推送未送达：{{item.subscribe.message}}
              </text>
            </view>
            <text wx:if="{{!item.read}}" class="tag tag-primary">新</text>
          </view>
        </view>
        <view wx:else class="empty notice-empty">
          <text class="empty-title">暂无通知</text>
          <text class="empty-desc">成员核销后会在这里提醒您</text>
        </view>
      </view>

      <view wx:else class="empty notice-empty">
        <text class="empty-title">当前账本为查看权限</text>
        <text class="empty-desc">可查看成员与次数，操作需账本创建者授权</text>
      </view>
    </view>

    <!-- 操作 -->
    <view class="list">
      <view wx:if="{{canManage && book && book.id}}" class="list-item" bindtap="handleClearCache">
        <view class="list-main">
          <text class="list-title">清理当前账本测试数据</text>
          <text class="list-desc">清空成员、账单与通知</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
      <view class="list-item" bindtap="handleLogout">
        <view class="list-main">
          <text class="list-title danger-text">退出登录</text>
          <text class="list-desc">清除本机登录缓存</text>
        </view>
        <text class="list-arrow">›</text>
      </view>
    </view>

  </block>

</view>