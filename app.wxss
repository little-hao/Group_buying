/**
 * 拼单账本 - 全局样式
 *
 * 设计原则：
 * 1. 移动端优先
 * 2. 简洁实用，参考 iOS 分组卡片风格
 * 3. 减少复杂动画
 * 4. 页面统一圆角、间距、颜色
 * 5. 尽量避免给具体业务页面写重复样式
 */

/* =========================
   全局变量
   ========================= */

page {
  /* 主色：暖金 */
  --color-primary: #0A84FF;

  /* 主色深色（按钮文字/强调） */
  --color-primary-dark: #0066CC;

  /* 亮金（提示点等） */
  --color-gold-bright: #FFCC00;

  /* 奶油底色（软高亮卡片） */
  --color-cream: #F2F2F7;

  /* 成功色 */
  --color-success: #3F9D63;

  /* 警告色 */
  --color-warning: #E8A33D;

  /* 错误色 */
  --color-danger: #E05A4E;

  /* 主文字（暖黑） */
  --color-text: #1C1C1E;

  /* 次文字 */
  --color-text-secondary: #6C6C70;

  /* 辅助文字 */
  --color-text-light: #8E8E93;

  /* 页面背景 */
  --color-page-bg: #F2F2F7;

  /* 卡片背景 */
  --color-card-bg: #FFFFFF;

  /* 分割线 */
  --color-border: #E5E5EA;

  /* 基础圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 页面水平间距 */
  --page-padding: 32rpx;

  background-color: var(--color-page-bg);
  color: var(--color-text);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* =========================
   通用盒模型
   ========================= */

view,
scroll-view,
swiper,
swiper-item,
text,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

/* =========================
   页面根容器
   ========================= */

.page {
  min-height: 100vh;
  padding: 32rpx;
  background-color: var(--color-page-bg);
}

/* 页面顶部区域 */
.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text);
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

/* =========================
   通用卡片
   ========================= */

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background-color: var(--color-card-bg);
  border-radius: 24rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 卡片副标题 */
.card-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 奶油底卡片（高亮） */
.card-cream {
  background-color: var(--color-cream);
  border: 1rpx solid #EFE3C2;
}

/* =========================
   数据统计
   ========================= */

.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-number {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text);
}

.stats-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* =========================
   主按钮
   ========================= */

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 32rpx;
  margin: 0;
  border: none;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button::after {
  border: none;
}

/* =========================
   次级按钮
   ========================= */

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: #FFFFFF;
  color: var(--color-text);
  font-size: 28rpx;
}

.secondary-button::after {
  border: none;
}

/* =========================
   危险按钮
   ========================= */

.danger-button {
  color: var(--color-danger);
}

/* =========================
   表单
   ========================= */

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background-color: #FFFFFF;
  font-size: 28rpx;
  color: var(--color-text);
}

.form-input-placeholder {
  color: var(--color-text-light);
}

/* =========================
   列表
   ========================= */

.list {
  margin-bottom: 24rpx;
  background-color: var(--color-card-bg);
  border-radius: 24rpx;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.list-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.list-value {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* =========================
   成员头像
   ========================= */

.avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background-color: var(--color-cream);
  color: var(--color-primary-dark);
  text-align: center;
  font-size: 28rpx;
  line-height: 72rpx;
}

/* =========================
   状态标签
   ========================= */

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-success {
  background-color: #EAF6EF;
  color: var(--color-success);
}

.tag-warning {
  background-color: #FDF3E0;
  color: var(--color-warning);
}

.tag-danger {
  background-color: #FDECEA;
  color: var(--color-danger);
}

.tag-primary {
  background-color: var(--color-cream);
  color: var(--color-primary-dark);
}

/* =========================
   空状态
   ========================= */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* =========================
   分割线
   ========================= */

.divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-border);
}

/* =========================
   Flex 工具类
   ========================= */

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* =========================
   间距工具类
   ========================= */

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }

/* =========================
   文字工具类
   ========================= */

.text-primary { color: var(--color-primary-dark); }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }
.text-secondary { color: var(--color-text-secondary); }
.text-light { color: var(--color-text-light); }
.text-bold { font-weight: 600; }

/* =========================
   安全区域
   ========================= */

/* 给底部固定按钮/区域使用。
   iPhone 等全面屏设备会自动增加底部安全距离。 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* =========================
   固定底部操作栏
   ========================= */

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -4rpx 20rpx rgba(43, 38, 32, 0.05);
}
/* 小号胶囊按钮（各页面通用） */
.small-button {
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 20rpx;
  margin: 0;
  border: none;
  border-radius: 44rpx;
  background-color: #F2F2F7;
  color: var(--color-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 64rpx;
}

.small-button::after {
  border: none;
}
